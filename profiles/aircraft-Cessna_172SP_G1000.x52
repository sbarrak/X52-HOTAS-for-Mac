bind 25 4 press "Taxi light" cmd:sim/lights/taxi_lights_toggle
bind 26 4 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 4 press "Nav lights" cmd:sim/lights/nav_lights_toggle
bind 3 5 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 5 press "Flight director" cmd:sim/autopilot/fdir_toggle
bind 7 5 press "AP wing leveler" cmd:sim/autopilot/wing_leveler
bind 9 5 press "AP HDG" cmd:sim/autopilot/heading
bind 10 5 press "AP NAV" cmd:sim/autopilot/NAV
bind 11 5 press "AP ALT hold" cmd:sim/autopilot/altitude_hold
bind 12 5 press "AP VS" cmd:sim/autopilot/vertical_speed
bind 13 5 press "AP FLC" cmd:sim/autopilot/level_change
bind 17 5 press "Zoom in" cmd:sim/general/zoom_in
bind 18 5 press "Zoom out" cmd:sim/general/zoom_out
bind 24 5 press "ALT select +" cmd:sim/autopilot/altitude_up
bind 25 5 press "VS +" cmd:sim/autopilot/vertical_speed_up
bind 26 5 press "ALT select -" cmd:sim/autopilot/altitude_down
bind 27 5 press "VS -" cmd:sim/autopilot/vertical_speed_down
bind 3 6 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 6 press "AP approach" cmd:sim/autopilot/approach
bind 9 6 press "AP HDG" cmd:sim/autopilot/heading
bind 10 6 press "AP NAV" cmd:sim/autopilot/NAV
