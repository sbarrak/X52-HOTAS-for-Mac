x52pro-profile 3
# X52 Pro profile for the Grumman F-14 Tomcat (ready-made, see profiles/README.md).
name = F-14D
# standard: a ready-made profile, never changed by the app or the plugin (changes go to a copy)
standard = 1
pinkie_shift = 0
shift_button = 6
mode_buttons = 28 29 30
clutch_safe = 1
clutch_button = 31
hold_ms = 400
mode_settle_ms = 100
# modes: 1 takeoff, 2 cruise, 3 landing; the screen says the mode's name for mode_banner_ms (0: never)
mode_layout = 2
mode_name_1 = Takeoff
mode_name_2 = Combat
mode_name_3 = Landing
mode_banner_ms = 1500
mfd_brightness = 127
led_brightness = 127
clutch_latched = 0
clock2_offset = 0
clock3_offset = 0
clock1_12h = 0
clock2_12h = 0
clock3_12h = 0
date_format = 0
com_833 = 0
axis_override = 1
throttle_plugin = 1
axis_roll = 5 0 0
axis_pitch = 5 0 0
axis_yaw = 5 0 0
axis_throttle = 5 0 1
slider_flaps = 1
slider_invert = 0
rotary_lower = 1
rotary_lower_invert = 0
rotary_upper = 2
rotary_upper_invert = 0
rotary_lower_range = 0 100
rotary_upper_range = 0 100
rotary_zoom_steps = 96
leds 1 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
leds 2 = fire:green a:green b:green d:amber e:amber t1:amber t2:amber t3:amber pov:amber clutch:green throttle:green
leds 3 = fire:green a:green b:green d:red e:red t1:red t2:red t3:red pov:red clutch:green throttle:green
ledsp 1 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
ledsp 2 = fire:green a:green b:green d:amber e:amber t1:amber t2:amber t3:amber pov:amber clutch:green throttle:green
ledsp 3 = fire:green a:green b:green d:red e:red t1:red t2:red t3:red pov:red clutch:green throttle:green
rule fire > 0.5 green off sim/cockpit2/weapons/master_arm
rule a > 0.99 green off sim/flightmodel2/gear/deploy_ratio[0]
rule b > 0.01 amber green sim/cockpit2/controls/flap_handle_deploy_ratio
alarm fire blink fast red amber "Engine fire" > 0 sim/cockpit2/annunciators/engine_fires[0] or > 0 sim/cockpit2/annunciators/engine_fires[1]
alarm pov blink fast red amber "Stall" > 0 sim/cockpit2/annunciators/stall_warning
alarm a blink slow red amber "Gear unsafe" > 0 sim/cockpit2/annunciators/gear_unsafe
alarm clutch blink fast red amber "Master warning" > 0 sim/cockpit2/annunciators/master_warning
alarm clutch blink slow amber red "Master caution" > 0 sim/cockpit2/annunciators/master_caution
alarm t1 alternate slow red amber "Low fuel" > 0 sim/cockpit2/annunciators/fuel_quantity
alarm t3 blink fast red amber "Overspeed" > 0 sim/flightmodel/failures/over_vne
page flt "Flight"
row flt value "IAS" "%.0f kt" sim/cockpit2/gauges/indicators/airspeed_kts_pilot
row flt value "Alt" "%.0f ft" sim/cockpit2/gauges/indicators/altitude_ft_pilot
row flt value "VS" "%.0f fpm" sim/cockpit2/gauges/indicators/vvi_fpm_pilot
row flt value "Hdg" "%.0f deg" sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot
row flt value "Mach" "%.2f" sim/cockpit2/gauges/indicators/mach_pilot
row flt value "G" "%.1f" sim/flightmodel2/misc/gforce_normal
row flt value "AoA" "%.1f deg" sim/flightmodel2/misc/AoA_angle_degrees
row flt value "OAT" "%.0f C" sim/cockpit2/temperature/outside_air_temp_degc
page eng "Engine"
row eng value "N1 L" "%.1f" sim/cockpit2/engine/indicators/N1_percent[0]
row eng value "N1 R" "%.1f" sim/cockpit2/engine/indicators/N1_percent[1]
row eng value "Oil T" "%.0f C" sim/cockpit2/engine/indicators/oil_temperature_deg_C[0]
row eng value "Oil P" "%.0f psi" sim/cockpit2/engine/indicators/oil_pressure_psi[0]
page fuel "Fuel"
row fuel value "Total" "%.0f kg" sim/flightmodel/weight/m_fuel_total
row fuel value "Left" "%.0f kg" sim/cockpit2/fuel/fuel_quantity[0]
row fuel value "Right" "%.0f kg" sim/cockpit2/fuel/fuel_quantity[1]
master screen == 1 sim/cockpit2/switches/avionics_power_on
master lights == 1 sim/cockpit2/switches/avionics_power_on
bind 1 any press "Fire selected weapon" cmd:sim/weapons/fire_any_armed
bind 2 any press "Flares" cmd:sim/weapons/deploy_flares
bind 4 any press "Speedbrake in" cmd:sim/flight_controls/speed_brakes_up_one
bind 5 any press "Speedbrake out" cmd:sim/flight_controls/speed_brakes_down_one
bind 6 any press "Brakes (hold)" cmd:sim/flight_controls/brakes_regular
bind 15 any press "Guns" cmd:sim/weapons/fire_guns
bind 16 any press "Cockpit view" cmd:sim/view/3d_cockpit_cmnd_look
bind 20 any press "Trim nose down" cmd:sim/flight_controls/pitch_trim_down
bind 22 any press "Trim nose up" cmd:sim/flight_controls/pitch_trim_up
bind 35 any press "Screen page -" cmd:x52pro/mfd_page_prev
bind 36 any press "Screen page +" cmd:x52pro/mfd_page_next
bind 37 any press "Screen cursor up" cmd:x52pro/mfd_up
bind 38 any press "Screen cursor down" cmd:x52pro/mfd_down
bind 39 any press "Screen select" cmd:x52pro/mfd_select
bind 40 any press "Look up" cmd:sim/general/rot_up
bind 41 any press "Look right" cmd:sim/general/rot_right
bind 42 any press "Look down" cmd:sim/general/rot_down
bind 43 any press "Look left" cmd:sim/general/rot_left
bind 44 any press "Pan up" cmd:sim/general/up
bind 45 any press "Pan right" cmd:sim/general/right
bind 46 any press "Pan down" cmd:sim/general/down
bind 47 any press "Pan left" cmd:sim/general/left
bind 48 any press "Pan up fast" cmd:sim/general/up_fast
bind 49 any press "Pan right fast" cmd:sim/general/right_fast
bind 50 any press "Pan down fast" cmd:sim/general/down_fast
bind 51 any press "Pan left fast" cmd:sim/general/left_fast
bind 3 1 press "Gear up/down" cmd:sim/flight_controls/landing_gear_toggle
bind 3 1 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 7 1 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 8 1 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 9 1 press "Battery on" cmd:sim/electrical/battery_1_on
bind 10 1 press "Battery off" cmd:sim/electrical/battery_1_off
bind 11 1 press "Avionics on" cmd:sim/systems/avionics_on
bind 12 1 press "Avionics off" cmd:sim/systems/avionics_off
bind 13 1 press "Canopy open" cmd:sim/flight_controls/canopy_open
bind 14 1 press "Canopy close" cmd:sim/flight_controls/canopy_close
bind 17 1 press "Zoom in" cmd:sim/general/zoom_in
bind 18 1 press "Zoom out" cmd:sim/general/zoom_out
bind 19 1 press "Chase view" cmd:sim/view/chase
bind 24 1 press "Nav lights on" cmd:laminar/f14/ltng/wing_nav_light_switch_up
bind 25 1 press "Taxi light" cmd:laminar/f14/ltng/taxi_light_switch
bind 26 1 press "Nav lights off" cmd:laminar/f14/ltng/wing_nav_light_switch_dn
bind 3 2 press "Landing light" cmd:sim/lights/landing_lights_toggle
bind 3 2 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 7 2 press "Master arm" cmd:laminar/f14/weapons/switch/master_arm_switch
bind 9 2 press "Target next" cmd:sim/weapons/weapon_target_up
bind 10 2 press "Target prev" cmd:sim/weapons/weapon_target_down
bind 11 2 press "Flares" cmd:sim/weapons/deploy_flares
bind 12 2 press "Chaff" cmd:sim/weapons/deploy_chaff
bind 13 2 press "Wings forward" cmd:sim/flight_controls/vector_sweep_forward
bind 14 2 press "Wings aft" cmd:sim/flight_controls/vector_sweep_aft
bind 17 2 press "Trim nose down" cmd:sim/flight_controls/pitch_trim_down
bind 18 2 press "Trim nose up" cmd:sim/flight_controls/pitch_trim_up
bind 19 2 press "Take-off trim" cmd:sim/flight_controls/pitch_trim_takeoff
bind 24 2 press "Sidewinder" cmd:laminar/f14/fltc/cs_wpn_select_switch1
bind 25 2 press "Sparrow" cmd:laminar/f14/fltc/cs_wpn_select_switch2
bind 26 2 press "Gun" cmd:laminar/f14/fltc/cs_wpn_select_switch3
bind 27 2 press "Phoenix" cmd:laminar/f14/fltc/cs_wpn_select_switch4
bind 3 3 press "Gear up/down" cmd:sim/flight_controls/landing_gear_toggle
bind 3 3 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 7 3 press "Speedbrake" cmd:sim/flight_controls/speed_brakes_toggle
bind 8 3 press "Tail hook" cmd:sim/flight_controls/tailhook_toggle
bind 9 3 press "Landing lt on" cmd:sim/lights/landing_lights_on
bind 10 3 press "Landing lt off" cmd:sim/lights/landing_lights_off
bind 13 3 press "Pitot heat on" cmd:sim/ice/pitot_heat0_on
bind 14 3 press "Pitot heat off" cmd:sim/ice/pitot_heat0_off
bind 17 3 press "Trim nose down" cmd:sim/flight_controls/pitch_trim_down
bind 18 3 press "Trim nose up" cmd:sim/flight_controls/pitch_trim_up
bind 19 3 press "Take-off trim" cmd:sim/flight_controls/pitch_trim_takeoff
bind 24 3 press "Speedbrake in" cmd:sim/flight_controls/speed_brakes_up_one
bind 26 3 press "Speedbrake out" cmd:sim/flight_controls/speed_brakes_down_one
