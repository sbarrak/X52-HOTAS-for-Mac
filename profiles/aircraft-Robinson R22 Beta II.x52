x52pro-profile 3
# X52 Pro profile for the Robinson R22 Beta II (ready-made, see profiles/README.md).
name = Robinson R22 Beta II
# standard: a ready-made profile, never changed by the app or the plugin (changes go to a copy)
standard = 1
pinkie_shift = 1
shift_button = 6
mode_buttons = 28 29 30
clutch_safe = 1
clutch_button = 31
hold_ms = 400
mode_settle_ms = 100
# modes: 1 takeoff, 2 cruise, 3 landing; the screen says the mode's name for mode_banner_ms (0: never)
mode_layout = 2
mode_name_1 = Takeoff
mode_name_2 = Cruise
mode_name_3 = Landing
mode_banner_ms = 1500
mfd_brightness = 127
led_brightness = 127
clutch_latched = 0
clock2_offset = 0
clock3_offset = 0
clock1_12h = 0
clock2_12h = 0
clock3_12h = 0
date_format = 0
com_833 = 0
axis_override = 1
throttle_plugin = 0
axis_roll = 5 0 0
axis_pitch = 5 0 0
axis_yaw = 5 0 0
axis_throttle = 5 0 1
slider_flaps = 0
slider_invert = 0
rotary_lower = 0
rotary_lower_invert = 0
rotary_upper = 8
rotary_upper_invert = 0
rotary_lower_range = 0 100
rotary_upper_range = 0 100
rotary_zoom_steps = 96
leds 1 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
leds 2 = fire:green a:green b:green d:amber e:amber t1:amber t2:amber t3:amber pov:amber clutch:green throttle:green
leds 3 = fire:green a:green b:green d:red e:red t1:red t2:red t3:red pov:red clutch:green throttle:green
ledsp 1 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
ledsp 2 = fire:green a:green b:green d:amber e:amber t1:amber t2:amber t3:amber pov:amber clutch:green throttle:green
ledsp 3 = fire:green a:green b:green d:red e:red t1:red t2:red t3:red pov:red clutch:green throttle:green
rule fire > 0.5 green off sim/flightmodel/controls/parkbrake
alarm fire blink fast red amber "Engine fire" > 0 sim/cockpit2/annunciators/engine_fires[0]
alarm pov blink fast red amber "Low rotor RPM" > 0 sim/cockpit2/annunciators/low_rotor
alarm t1 alternate slow red amber "Low fuel" > 0 sim/cockpit2/annunciators/fuel_quantity
alarm t3 blink fast red amber "Overspeed" > 0 sim/flightmodel/failures/over_vne
page flt "Flight"
row flt value "IAS" "%.0f kt" sim/cockpit2/gauges/indicators/airspeed_kts_pilot
row flt value "Alt" "%.0f ft" sim/cockpit2/gauges/indicators/altitude_ft_pilot
row flt value "VS" "%.0f fpm" sim/cockpit2/gauges/indicators/vvi_fpm_pilot
row flt value "Hdg" "%.0f deg" sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot
row flt value "Radio" "%.0f ft" sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot
row flt value "OAT" "%.0f C" sim/cockpit2/temperature/outside_air_temp_degc
page eng "Engine"
row eng value "Rotor" "%.0f rpm" sim/cockpit2/engine/indicators/prop_speed_rpm[0]
row eng value "Eng" "%.0f rpm" sim/cockpit2/engine/indicators/engine_speed_rpm[0]
row eng value "Oil T" "%.0f C" sim/cockpit2/engine/indicators/oil_temperature_deg_C[0]
row eng value "Oil P" "%.0f psi" sim/cockpit2/engine/indicators/oil_pressure_psi[0]
page fuel "Fuel"
row fuel value "Total" "%.0f kg" sim/flightmodel/weight/m_fuel_total
row fuel value "Left" "%.0f kg" sim/cockpit2/fuel/fuel_quantity[0]
row fuel value "Right" "%.0f kg" sim/cockpit2/fuel/fuel_quantity[1]
master screen == 1 sim/cockpit2/switches/avionics_power_on
master lights == 1 sim/cockpit2/switches/avionics_power_on
bind 1 any press "Contact ATC" cmd:sim/operation/contact_atc
bind 4 any press "Governor" cmd:sim/engines/governor_toggle
bind 5 any press "Carb heat" cmd:sim/engines/carb_heat_toggle
bind 8 any press "Brakes (hold)" cmd:sim/flight_controls/brakes_regular
bind 16 any press "Cockpit view" cmd:sim/view/3d_cockpit_cmnd_look
bind 35 any press "Screen page -" cmd:x52pro/mfd_page_prev
bind 36 any press "Screen page +" cmd:x52pro/mfd_page_next
bind 37 any press "Screen cursor up" cmd:x52pro/mfd_up
bind 38 any press "Screen cursor down" cmd:x52pro/mfd_down
bind 39 any press "Screen select" cmd:x52pro/mfd_select
bind 40 any press "Look up" cmd:sim/general/rot_up
bind 41 any press "Look right" cmd:sim/general/rot_right
bind 42 any press "Look down" cmd:sim/general/rot_down
bind 43 any press "Look left" cmd:sim/general/rot_left
bind 44 any press "Pan up" cmd:sim/general/up
bind 45 any press "Pan right" cmd:sim/general/right
bind 46 any press "Pan down" cmd:sim/general/down
bind 47 any press "Pan left" cmd:sim/general/left
bind 48 any press "Pan up fast" cmd:sim/general/up_fast
bind 49 any press "Pan right fast" cmd:sim/general/right_fast
bind 50 any press "Pan down fast" cmd:sim/general/down_fast
bind 51 any press "Pan left fast" cmd:sim/general/left_fast
bind 9 1 press "Battery on" cmd:sim/electrical/battery_1_on ; cmd:sim/electrical/battery_2_on
bind 10 1 press "Battery off" cmd:sim/electrical/battery_1_off ; cmd:sim/electrical/battery_2_off
bind 13 1 press "Governor on" cmd:sim/engines/governor_on
bind 14 1 press "Governor off" cmd:sim/engines/governor_off
bind 17 1 press "Zoom in" cmd:sim/general/zoom_in
bind 18 1 press "Zoom out" cmd:sim/general/zoom_out
bind 19 1 press "Chase view" cmd:sim/view/chase
bind 24 1 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 26 1 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 1 press "Nav lights" cmd:sim/lights/nav_lights_toggle
bind 9 2 press "Fuel tank left" cmd:sim/fuel/fuel_tank_selector_lft_one
bind 10 2 press "Fuel tank right" cmd:sim/fuel/fuel_tank_selector_rgt_one
bind 17 2 press "Trim nose down" cmd:sim/flight_controls/pitch_trim_down
bind 18 2 press "Trim nose up" cmd:sim/flight_controls/pitch_trim_up
bind 24 2 press "Cockpit view" cmd:sim/view/3d_cockpit_cmnd_look
bind 25 2 press "Circle view" cmd:sim/view/circle
bind 26 2 press "Chase view" cmd:sim/view/chase
bind 27 2 press "Free camera" cmd:sim/view/free_camera
bind 17 3 press "Trim nose down" cmd:sim/flight_controls/pitch_trim_down
bind 18 3 press "Trim nose up" cmd:sim/flight_controls/pitch_trim_up
bind 24 3 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 26 3 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 3 press "Nav lights" cmd:sim/lights/nav_lights_toggle
bind 9 4 press "Battery on" cmd:sim/electrical/battery_1_on ; cmd:sim/electrical/battery_2_on
bind 10 4 press "Battery off" cmd:sim/electrical/battery_1_off ; cmd:sim/electrical/battery_2_off
bind 13 4 press "Governor on" cmd:sim/engines/governor_on
bind 14 4 press "Governor off" cmd:sim/engines/governor_off
bind 17 4 press "Zoom in" cmd:sim/general/zoom_in
bind 18 4 press "Zoom out" cmd:sim/general/zoom_out
bind 24 4 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 26 4 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 4 press "Nav lights" cmd:sim/lights/nav_lights_toggle
bind 9 5 press "Fuel tank left" cmd:sim/fuel/fuel_tank_selector_lft_one
bind 10 5 press "Fuel tank right" cmd:sim/fuel/fuel_tank_selector_rgt_one
bind 17 5 press "Zoom in" cmd:sim/general/zoom_in
bind 18 5 press "Zoom out" cmd:sim/general/zoom_out
bind 24 5 press "Cockpit view" cmd:sim/view/3d_cockpit_cmnd_look
bind 25 5 press "Circle view" cmd:sim/view/circle
bind 26 5 press "Chase view" cmd:sim/view/chase
bind 27 5 press "Free camera" cmd:sim/view/free_camera
bind 17 6 press "Zoom in" cmd:sim/general/zoom_in
bind 18 6 press "Zoom out" cmd:sim/general/zoom_out
bind 24 6 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 26 6 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 6 press "Nav lights" cmd:sim/lights/nav_lights_toggle
