x52pro-profile 3
# X52 Pro button profile. Written by the X52 Pro plugin; safe to edit by hand.
name = A330_new
pinkie_shift = 1
shift_button = 6
mode_buttons = 28 29 30
clutch_safe = 1
clutch_button = 31
hold_ms = 400
mode_settle_ms = 100
mfd_brightness = 127
led_brightness = 127
clutch_latched = 0
# clocks: clock 1 is GMT; clock 2 and 3 are minutes from GMT. date_format: 0 DD-MM-YY, 1 MM-DD-YY, 2 YY-MM-DD
clock2_offset = 0
clock3_offset = 0
clock1_12h = 0
clock2_12h = 0
clock3_12h = 0
date_format = 0
com_833 = 0
axis_override = 0
# axis_<name> = dead zone %, expo %, inverted (1/0)
axis_roll = 5 0 0
axis_pitch = 5 0 0
axis_yaw = 5 0 0
axis_throttle = 5 0 0
dial_accel = 1
dial_slow_ms = 150
dial_fast_ms = 60
dial_factor = 10
leds 1 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
leds 2 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
leds 3 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
# leds with the pinkie held, per mode
ledsp 1 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
ledsp 2 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
ledsp 3 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
# rule <light> <op> <number> <colour if true> <colour if not> [not] <dataref> [and|or [not] <op> <number> <dataref>]
#   colours: off green amber red mode. One rule per light; the first rule that has a colour wins. A dataref of - is not chosen yet.
# alarm <light> <steady|blink|alternate> <slow|fast> <colour> <colour 2> "name" [not] <op> <number> <dataref> [and|or [not] <op> <number> <dataref>]
#   alarms beat the rules above and the mode colours; the first alarm that is triggered wins, one that is not leaves the light to the next.
# master <screen|lights> [not] <op> <number> <dataref> [and|or [not] <op> <number> <dataref>]
#   the screen (or every light) is on only while this is true, e.g. avionics power. No master line: always on.
# brightness <screen|lights> <value at dim> <value at bright> <dim 0..127> <bright 0..127> <dataref>
#   the brightness follows the dataref between those two points. No line: the fixed brightness above.
# bind <button> <any|1..6> <press|hold> "label" step ; step ...
#   layers 1-3 = mode 1-3, 4-6 = mode 1-3 with the pinkie held
#   steps: cmd:<x-plane command>   key:<combo e.g. shift+f1>   wait:<milliseconds>
#          set:<dataref>=<value>   toggle:<dataref>=<a>,<b>   add:<dataref>=<amount>[,<min>,<max>]
bind 3 any press "" cmd:sim/FMS/CDU_popup
bind 5 any press "" cmd:sim/flight_controls/landing_gear_toggle
bind 7 any press "" cmd:sim/flight_controls/brakes_toggle_regular
bind 16 any press "" cmd:sim/flight_controls/brakes_toggle_regular
bind 20 any press "" cmd:sim/view/quick_look_1
bind 21 any press "" cmd:sim/view/quick_look_2
bind 22 any press "" cmd:sim/view/quick_look_3
bind 23 any press "" cmd:sim/view/quick_look_0
bind 35 any press "Screen page -" cmd:x52pro/mfd_page_prev
bind 36 any press "Screen page +" cmd:x52pro/mfd_page_next
bind 37 any press "Screen cursor up" cmd:x52pro/mfd_up
bind 38 any press "Screen cursor down" cmd:x52pro/mfd_down
bind 39 any press "Screen select" cmd:x52pro/mfd_select
bind 40 any press "Look up" cmd:sim/general/rot_up
bind 41 any press "Look right" cmd:sim/general/rot_right
bind 42 any press "Look down" cmd:sim/general/rot_down
bind 43 any press "Look left" cmd:sim/general/rot_left
bind 44 any press "Pan up" cmd:sim/general/up
bind 45 any press "Pan right" cmd:sim/general/right
bind 46 any press "Pan down" cmd:sim/general/down
bind 47 any press "Pan left" cmd:sim/general/left
bind 48 any press "Pan up fast" cmd:sim/general/up_fast
bind 49 any press "Pan right fast" cmd:sim/general/right_fast
bind 50 any press "Pan down fast" cmd:sim/general/down_fast
bind 51 any press "Pan left fast" cmd:sim/general/left_fast
