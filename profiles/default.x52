bind 12 6 press "Spoilers retract" cmd:sim/flight_controls/speed_brakes_up_all
bind 13 6 press "Pitot heat on" cmd:sim/ice/pitot_heat0_on
bind 14 6 press "Pitot heat off" cmd:sim/ice/pitot_heat0_off
bind 17 6 press "Zoom in" cmd:sim/general/zoom_in
bind 18 6 press "Zoom out" cmd:sim/general/zoom_out
bind 24 6 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 25 6 press "Taxi light" cmd:sim/lights/taxi_lights_toggle
bind 26 6 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 6 press "Nav lights" cmd:sim/lights/nav_lights_toggle
# brightness <screen|lights> <value at dim> <value at bright> <dim 0..127> <bright 0..127> <dataref>
#   the brightness follows the dataref between those two points. No line: the fixed brightness above.
# bind <button> <any|1..6> <press|hold> "label" step ; step ...
#   layers 1-3 = mode 1-3, 4-6 = mode 1-3 with the pinkie held
#   steps: cmd:<x-plane command>   key:<combo e.g. shift+f1>   wait:<milliseconds>
#          set:<dataref>=<value>   toggle:<dataref>=<a>,<b>   add:<dataref>=<amount>[,<min>,<max>]
rotary_lower = 1
rotary_lower_invert = 0
rotary_upper = 2
rotary_upper_invert = 0
rotary_lower_range = 0 100
rotary_upper_range = 0 100
rotary_zoom_steps = 96
