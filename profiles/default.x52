x52pro-profile 3
# X52 Pro button profile. Written by the X52 Pro plugin; safe to edit by hand.
name = default
# standard: a ready-made profile, never changed by the app or the plugin (changes go to a copy)
standard = 1
pinkie_shift = 1
shift_button = 6
mode_buttons = 28 29 30
clutch_safe = 0
clutch_button = 31
hold_ms = 400
mode_settle_ms = 100
# modes: 1 takeoff, 2 cruise, 3 landing; the screen says the mode's name for mode_banner_ms (0: never)
mode_layout = 2
mode_name_1 = Takeoff
mode_name_2 = Cruise
mode_name_3 = Landing
mode_banner_ms = 1500
mfd_brightness = 127
led_brightness = 127
clutch_latched = 0
# clocks: clock 1 is GMT; clock 2 and 3 are minutes from GMT. date_format: 0 DD-MM-YY, 1 MM-DD-YY, 2 YY-MM-DD
clock2_offset = 0
clock3_offset = 0
clock1_12h = 0
clock2_12h = 0
clock3_12h = 0
date_format = 0
com_833 = 0
leds 1 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:green clutch:green throttle:green
leds 2 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:amber clutch:green throttle:green
leds 3 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:red clutch:green throttle:green
# leds with the pinkie held, per mode
ledsp 1 = fire:green a:amber b:red d:amber e:amber t1:amber t2:amber t3:amber pov:green clutch:amber throttle:green
ledsp 2 = fire:green a:green b:green d:green e:green t1:green t2:green t3:green pov:amber clutch:green throttle:green
ledsp 3 = fire:green a:green b:green d:green e:green t1:red t2:red t3:red pov:amber clutch:green throttle:green
# rule <light> <op> <number> <colour if true> <colour if not> [not] <dataref> [and|or [not] <op> <number> <dataref>]
#   colours: off green amber red mode. One rule per light; the first rule that has a colour wins. A dataref of - is not chosen yet.
rule a == 0.5 amber green sim/flightmodel2/engines/thrust_reverser_deploy_ratio
# alarm <light> <steady|blink|alternate> <slow|fast> <colour> <colour 2> "name" [not] <op> <number> <dataref> [and|or [not] <op> <number> <dataref>]
#   alarms beat the rules above and the mode colours; the first alarm that is triggered wins, one that is not leaves the light to the next.
# master <screen|lights> [not] <op> <number> <dataref> [and|or [not] <op> <number> <dataref>]
#   the screen (or every light) is on only while this is true, e.g. avionics power. No master line: always on.
master screen == 1 sim/cockpit2/switches/avionics_power_on
master lights == 1 sim/cockpit2/switches/avionics_power_on
# The shared layout of the ready-made civil profiles (issue #121), with X-Plane's generic commands.
bind 1 any press "AP disconnect" cmd:sim/autopilot/servos_off_any
bind 4 any press "AP on/off" cmd:sim/autopilot/servos_toggle
bind 8 any press "Brakes (hold)" cmd:sim/flight_controls/brakes_regular
bind 15 any press "Contact ATC" cmd:sim/operation/contact_atc
bind 16 any press "Cockpit view" cmd:sim/view/3d_cockpit_cmnd_look
bind 20 any press "Trim nose down" cmd:sim/flight_controls/pitch_trim_down
bind 21 any press "Rudder trim R" cmd:sim/flight_controls/rudder_trim_right
bind 22 any press "Trim nose up" cmd:sim/flight_controls/pitch_trim_up
bind 23 any press "Rudder trim L" cmd:sim/flight_controls/rudder_trim_left
bind 35 any press "Screen page -" cmd:x52pro/mfd_page_prev
bind 36 any press "Screen page +" cmd:x52pro/mfd_page_next
bind 37 any press "Screen cursor up" cmd:x52pro/mfd_up
bind 38 any press "Screen cursor down" cmd:x52pro/mfd_down
bind 39 any press "Screen select" cmd:x52pro/mfd_select
bind 40 any press "Look up" cmd:sim/general/rot_up
bind 41 any press "Look right" cmd:sim/general/rot_right
bind 42 any press "Look down" cmd:sim/general/rot_down
bind 43 any press "Look left" cmd:sim/general/rot_left
bind 44 any press "Pan up" cmd:sim/general/up
bind 45 any press "Pan right" cmd:sim/general/right
bind 46 any press "Pan down" cmd:sim/general/down
bind 47 any press "Pan left" cmd:sim/general/left
bind 48 any press "Pan up fast" cmd:sim/general/up_fast
bind 49 any press "Pan right fast" cmd:sim/general/right_fast
bind 50 any press "Pan down fast" cmd:sim/general/down_fast
bind 51 any press "Pan left fast" cmd:sim/general/left_fast
bind 3 1 press "Gear up/down" cmd:sim/flight_controls/landing_gear_toggle
bind 3 1 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 1 press "Flight director" cmd:sim/autopilot/fdir_toggle
bind 7 1 press "Beacon" cmd:sim/lights/beacon_lights_toggle
bind 9 1 press "Battery on" cmd:sim/electrical/battery_1_on
bind 10 1 press "Battery off" cmd:sim/electrical/battery_1_off
bind 11 1 press "Avionics on" cmd:sim/systems/avionics_on
bind 12 1 press "Avionics off" cmd:sim/systems/avionics_off
bind 17 1 press "Zoom in" cmd:sim/general/zoom_in
bind 18 1 press "Zoom out" cmd:sim/general/zoom_out
bind 19 1 press "Chase view" cmd:sim/view/chase
bind 24 1 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 25 1 press "Taxi light" cmd:sim/lights/taxi_lights_toggle
bind 26 1 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 1 press "Nav lights" cmd:sim/lights/nav_lights_toggle
bind 3 2 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 2 press "AP approach" cmd:sim/autopilot/approach
bind 7 2 press "AP wing leveler" cmd:sim/autopilot/wing_leveler
bind 9 2 press "AP HDG" cmd:sim/autopilot/heading
bind 10 2 press "AP NAV" cmd:sim/autopilot/NAV
bind 11 2 press "AP ALT hold" cmd:sim/autopilot/altitude_hold
bind 12 2 press "AP VS" cmd:sim/autopilot/vertical_speed
bind 13 2 press "AP FLC" cmd:sim/autopilot/level_change
bind 17 2 press "HDG bug +" cmd:sim/autopilot/heading_up
bind 18 2 press "HDG bug -" cmd:sim/autopilot/heading_down
bind 19 2 press "HDG sync" cmd:sim/autopilot/heading_sync
bind 24 2 press "ALT select +" cmd:sim/autopilot/altitude_up
bind 25 2 press "VS +" cmd:sim/autopilot/vertical_speed_up
bind 26 2 press "ALT select -" cmd:sim/autopilot/altitude_down
bind 27 2 press "VS -" cmd:sim/autopilot/vertical_speed_down
bind 3 3 press "Gear up/down" cmd:sim/flight_controls/landing_gear_toggle
bind 3 3 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 3 press "AP approach" cmd:sim/autopilot/approach
bind 7 3 press "Reverse (hold)" cmd:sim/engines/thrust_reverse_hold
bind 9 3 press "Autobrake up" cmd:sim/flight_controls/brakes_up_auto
bind 10 3 press "Autobrake down" cmd:sim/flight_controls/brakes_dn_auto
bind 11 3 press "Spoilers arm" cmd:sim/flight_controls/speed_brakes_arm_toggle
bind 12 3 press "Spoilers retract" cmd:sim/flight_controls/speed_brakes_up_all
bind 13 3 press "Pitot heat on" cmd:sim/ice/pitot_heat0_on
bind 14 3 press "Pitot heat off" cmd:sim/ice/pitot_heat0_off
bind 17 3 press "Trim nose down" cmd:sim/flight_controls/pitch_trim_down
bind 18 3 press "Trim nose up" cmd:sim/flight_controls/pitch_trim_up
bind 19 3 press "Take-off trim" cmd:sim/flight_controls/pitch_trim_takeoff
bind 24 3 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 25 3 press "Taxi light" cmd:sim/lights/taxi_lights_toggle
bind 26 3 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 3 press "Nav lights" cmd:sim/lights/nav_lights_toggle
bind 3 4 press "Gear up/down" cmd:sim/flight_controls/landing_gear_toggle
bind 3 4 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 4 press "Flight director" cmd:sim/autopilot/fdir_toggle
bind 7 4 press "Beacon" cmd:sim/lights/beacon_lights_toggle
bind 9 4 press "Battery on" cmd:sim/electrical/battery_1_on
bind 10 4 press "Battery off" cmd:sim/electrical/battery_1_off
bind 11 4 press "Avionics on" cmd:sim/systems/avionics_on
bind 12 4 press "Avionics off" cmd:sim/systems/avionics_off
bind 17 4 press "Zoom in" cmd:sim/general/zoom_in
bind 18 4 press "Zoom out" cmd:sim/general/zoom_out
bind 24 4 press "Landing lights" cmd:sim/lights/landing_lights_toggle
bind 25 4 press "Taxi light" cmd:sim/lights/taxi_lights_toggle
bind 26 4 press "Strobes" cmd:sim/lights/strobe_lights_toggle
bind 27 4 press "Nav lights" cmd:sim/lights/nav_lights_toggle
bind 3 5 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 5 press "Flight director" cmd:sim/autopilot/fdir_toggle
bind 7 5 press "AP wing leveler" cmd:sim/autopilot/wing_leveler
bind 9 5 press "AP HDG" cmd:sim/autopilot/heading
bind 10 5 press "AP NAV" cmd:sim/autopilot/NAV
bind 11 5 press "AP ALT hold" cmd:sim/autopilot/altitude_hold
bind 12 5 press "AP VS" cmd:sim/autopilot/vertical_speed
bind 13 5 press "AP FLC" cmd:sim/autopilot/level_change
bind 17 5 press "Zoom in" cmd:sim/general/zoom_in
bind 18 5 press "Zoom out" cmd:sim/general/zoom_out
bind 24 5 press "ALT select +" cmd:sim/autopilot/altitude_up
bind 25 5 press "VS +" cmd:sim/autopilot/vertical_speed_up
bind 26 5 press "ALT select -" cmd:sim/autopilot/altitude_down
bind 27 5 press "VS -" cmd:sim/autopilot/vertical_speed_down
bind 3 6 press "Gear up/down" cmd:sim/flight_controls/landing_gear_toggle
bind 3 6 hold "Parking brake" cmd:sim/flight_controls/brakes_toggle_max
bind 5 6 press "AP approach" cmd:sim/autopilot/approach
bind 7 6 press "Reverse (hold)" cmd:sim/engines/thrust_reverse_hold
bind 9 6 press "Autobrake up" cmd:sim/flight_controls/brakes_up_auto
bind 10 6 press "Autobrake down" cmd:sim/flight_controls/brakes_dn_auto
